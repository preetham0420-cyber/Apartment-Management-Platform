# API Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME="Apartment Management Platform API"

# Client CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Database Configuration (Provisional - MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apartment_management_dev
DB_USER=app_user
DB_PASSWORD=your_secure_password_here
DB_CONNECTION_LIMIT=10

# Security Secrets (Do NOT commit actual values)
JWT_ACCESS_SECRET=your_provisional_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_provisional_jwt_refresh_secret_min_32_chars
