{
  "expo": {
    "name": "Apartment Resident",
    "slug": "apartment-resident",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.communityportal.residentapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "in.communityportal.residentapp",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e5b07eb4-6256-4860-b18b-d07cb020d5d6"
      }
    },
    "owner": "preethamgowda"
  }
}
