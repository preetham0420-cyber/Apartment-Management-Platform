# Mobile App Environment Configuration
# Use your computer's local IP address (e.g. http://192.168.1.100:4000/api) when testing on a physical phone with Expo Go
# Use http://10.0.2.2:4000/api when testing on an Android Emulator
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
EXPO_PUBLIC_APP_ENV=development
