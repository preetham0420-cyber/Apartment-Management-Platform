# ==============================================================================
# Apartment Management Platform - Environment Variables Template
# Copy this file to .env or workspace-specific .env files for local development.
# 
# SECURITY WARNING:
# NEVER commit real credentials, passwords, production API keys, or JWT secrets!
# Keep all values in this file strictly as placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
APP_NAME="Apartment Management Platform API"

# Client CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL 8.0+)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=apartment_management_dev
DB_USER=app_user
DB_PASSWORD=your_secure_password_here
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# 3. Security Tokens & JWT (Provisional placeholders - min 32 characters in prod)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_provisional_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_provisional_jwt_refresh_secret_min_32_chars

# ------------------------------------------------------------------------------
# 4. Super Admin Web (apps/admin-web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# 5. Resident Mobile App (apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000/api
